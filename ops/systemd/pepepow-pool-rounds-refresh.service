[Unit]
Description=PEPEPOW Pool Round Accounting Snapshot Refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pool-pepepow
EnvironmentFile=-/home/ubuntu/pool-pepepow/.runtime/systemd-smoke/core.env
Environment=PEPEPOW_LIVE_STRATUM_RUNTIME_DIR=/home/ubuntu/pool-pepepow/.runtime/live-stratum
ExecStart=/opt/pepepow-pool/ops/scripts/live-stratum.sh accepted-candidates
ExecStart=/opt/pepepow-pool/ops/scripts/live-stratum.sh track-rounds
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
