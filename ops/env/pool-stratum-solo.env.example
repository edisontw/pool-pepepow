# PEPEPOW Pool Pure SOLO Stratum Environment Configuration Example
PEPEPOW_POOL_CORE_MINING_MODE=solo
PEPEPOW_POOL_CORE_STRATUM_PORT=39334
PEPEPOW_POOL_CORE_STRATUM_BIND_PORT=39334
PEPEPOW_POOL_CORE_ACTIVITY_LOG_PATH=/var/lib/pepepow-pool/solo/share-events.jsonl
PEPEPOW_POOL_CORE_ACTIVITY_SNAPSHOT_OUTPUT=/var/lib/pepepow-pool/solo/activity-snapshot.json
PEPEPOW_SOLO_FEE_PERCENT=1.0
PEPEPOW_SOLO_PAYOUT_MIN_CONFIRMATIONS=101
# Pure SOLO production must submit valid block-target candidates automatically.
# Keep a bounded send ceiling as a safety guard; this is not a one-shot drill setting.
PEPEPOW_ENABLE_REAL_SUBMITBLOCK=true
PEPEPOW_REAL_SUBMITBLOCK_MAX_SENDS=1000
